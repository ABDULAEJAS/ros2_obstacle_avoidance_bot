<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Cybertruck Main Chassis Assembly -->
  <xacro:macro name="cybertruck_body">

    <!-- Lower Stainless Steel Main Body -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.38 0.22 0.08"/>
        </geometry>
        <material name="stainless_steel">
          <color rgba="0.75 0.77 0.80 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <geometry>
          <box size="0.38 0.22 0.08"/>
        </geometry>
      </collision>
      <xacro:inertial_box mass="1.2" x="0.38" y="0.22" z="0.08">
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <gazebo reference="base_link">
      <visual>
        <material>
          <ambient>0.75 0.77 0.80 1.0</ambient>
          <diffuse>0.75 0.77 0.80 1.0</diffuse>
          <specular>0.9 0.9 0.9 1.0</specular>
        </material>
      </visual>
    </gazebo>

    <!-- Angular Roof Vault (Tesla Cybertruck Cabin) -->
    <link name="roof_vault_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0.08 0"/>
        <geometry>
          <box size="0.22 0.20 0.07"/>
        </geometry>
        <material name="stainless_steel_dark">
          <color rgba="0.60 0.62 0.65 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0.08 0"/>
        <geometry>
          <box size="0.22 0.20 0.07"/>
        </geometry>
      </collision>
      <xacro:inertial_box mass="0.2" x="0.22" y="0.20" z="0.07">
        <origin xyz="0 0 0" rpy="0 0.08 0"/>
      </xacro:inertial_box>
    </link>

    <joint name="roof_vault_joint" type="fixed">
      <parent link="base_link"/>
      <child link="roof_vault_link"/>
      <origin xyz="-0.02 0 0.11" rpy="0 0 0"/>
    </joint>

    <gazebo reference="roof_vault_link">
      <visual>
        <material>
          <ambient>0.60 0.62 0.65 1.0</ambient>
          <diffuse>0.60 0.62 0.65 1.0</diffuse>
          <specular>0.8 0.8 0.8 1.0</specular>
        </material>
      </visual>
    </gazebo>

    <!-- Front LED Cyber Headlight Strip -->
    <link name="front_lightbar_link">
      <visual>
        <geometry>
          <box size="0.01 0.20 0.015"/>
        </geometry>
        <material name="cyber_cyan_led">
          <color rgba="0.0 0.95 1.0 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="front_lightbar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="front_lightbar_link"/>
      <origin xyz="0.191 0 0.055" rpy="0 0 0"/>
    </joint>

    <gazebo reference="front_lightbar_link">
      <visual>
        <material>
          <ambient>0.0 0.95 1.0 1.0</ambient>
          <diffuse>0.0 0.95 1.0 1.0</diffuse>
          <emissive>0.0 0.95 1.0 1.0</emissive>
        </material>
      </visual>
    </gazebo>

    <!-- Rear Red Cyber Taillight Strip -->
    <link name="rear_lightbar_link">
      <visual>
        <geometry>
          <box size="0.01 0.20 0.015"/>
        </geometry>
        <material name="cyber_red_led">
          <color rgba="1.0 0.0 0.1 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="rear_lightbar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rear_lightbar_link"/>
      <origin xyz="-0.191 0 0.055" rpy="0 0 0"/>
    </joint>

    <gazebo reference="rear_lightbar_link">
      <visual>
        <material>
          <ambient>1.0 0.0 0.1 1.0</ambient>
          <diffuse>1.0 0.0 0.1 1.0</diffuse>
          <emissive>1.0 0.0 0.1 1.0</emissive>
        </material>
      </visual>
    </gazebo>

  </xacro:macro>

</robot>
