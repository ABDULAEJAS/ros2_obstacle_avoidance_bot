<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Drive Wheel Macro -->
  <xacro:macro name="drive_wheel" params="name reflect">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.035"/>
        </geometry>
        <material name="matte_black">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.035"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.12" length="0.035" radius="0.05">
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${reflect * 0.125} 0.02" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${name}_wheel">
      <material>Gazebo/FlatBlack</material>
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
    </gazebo>
  </xacro:macro>

  <!-- Caster Wheel Macro -->
  <xacro:macro name="caster_wheel" params="name reflect">
    <link name="${name}_caster">
      <visual>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
        <material name="stainless_steel">
          <color rgba="0.75 0.77 0.80 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>
      <xacro:inertial_sphere mass="0.04" radius="0.02">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${reflect * 0.14} 0 -0.01" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_caster">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>
  </xacro:macro>

</robot>
